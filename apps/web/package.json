{
  "name": "@postific/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "bunx prisma generate",
    "db:validate": "bunx prisma validate",
    "db:migrate": "bun --env-file=.env.local x prisma migrate dev",
    "db:deploy": "bun --env-file=.env.local x prisma migrate deploy",
    "db:studio": "bun --env-file=.env.local x prisma studio",
    "postinstall": "bunx prisma generate"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.7",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@postific/shared": "workspace:*",
    "@supabase/supabase-js": "^2.110.7",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "next": "^16.2.10",
    "pg": "^8.16.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.7.0",
    "resend": "^6.30.0",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
