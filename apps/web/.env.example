# ─────────────────────────────────────────────────────────────
# apps/web/.env.example — copy to .env.local (EM-D04)
# Never commit .env.local. Values below are placeholders only.
# Local DB: Supabase Cloud project `social-media-local` (EM-D02).
# ─────────────────────────────────────────────────────────────

# Database — Prisma 7 (DO-D04)
# DATABASE_URL = Supavisor pooled — runtime PrismaClient (@prisma/adapter-pg) + Better Auth
# DIRECT_URL   = direct / session — prisma migrate via apps/web/prisma.config.ts
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase platform (Realtime + Storage only — DO-D02)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Browser (NEXT_PUBLIC_* only — EM-D05)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Better Auth (AS-D01, AS-D05)
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (optional locally; required when enabling Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Better Auth Dash — official hosted admin/monitoring dashboard (optional;
# plugin only activates when BETTER_AUTH_API_KEY is set)
BETTER_AUTH_API_KEY=""
# BETTER_AUTH_API_URL=""
# BETTER_AUTH_KV_URL=""

# Outstand integration
OUTSTAND_API_KEY="your-outstand-api-key"
OUTSTAND_WEBHOOK_SECRET="your-outstand-webhook-secret"
# Optional (T-025.1) — override base URL Outstand API kalau berbeda dari default
# resmi di kode (diverifikasi terhadap OpenAPI spec resmi Outstand, 2026-09-23:
# base URL TANPA suffix /v1 — tiap path sudah menyertakan /v1 sendiri)
# OUTSTAND_API_BASE_URL="https://api.outstand.so"
# Wajib untuk Connect Account. Dipakai membentuk redirect OAuth
# (https://www.outstand.so/app/api/socials/{network}/{orgId}).
# Kosong → connect gagal sebelum redirect. Bukan rahasia API; ID organisasi
# di dashboard Outstand, atau segmen terakhir path auth URL.
OUTSTAND_ORG_ID="your-outstand-org-id"

# Cron → web job trigger (X-Job-Secret)
JOB_SECRET="generate-a-long-random-job-secret"

# Resend — email verifikasi kepemilikan inbox di accept-invite (T-110, KI-053)
# Scope SEMPIT: hanya alur accept-invite untuk email yang belum punya akun,
# BUKAN requireEmailVerification Better Auth secara global (itu tetap T-005,
# provider transactional email belum ditetapkan — KI-001).
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="onboarding@yourdomain.com"

# Optional — set to 1 to skip fail-fast env checks (tests / tooling only)
# SKIP_ENV_VALIDATION=1
