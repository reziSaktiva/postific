// Prisma schema — Social Media Management
// Tables: identity_* (Better Auth) + domain MVP + cross-cutting system tables
// Source: product-discovery/05-architecture/database-strategy.md
// ORM strategy: product-discovery/06-engineering/database-orm.md (DO-D01–D05)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs live in prisma.config.ts (Prisma 7+).
  // Runtime pooled URL → PrismaClient adapter (DATABASE_URL).
  // Migrate/introspect → prisma.config.ts datasource.url (DIRECT_URL).
}

// ─────────────────────────────────────────────
// BC-01 — Identity (Better Auth / AS-D01, DO-D05)
// Prisma model names match Better Auth defaults;
// @@map applies identity_* table prefix (DB-D04).
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("identity_user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("identity_session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("identity_account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("identity_verification")
}

// ─────────────────────────────────────────────
// BC-02 — Workspace
// ─────────────────────────────────────────────

model Workspace {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  slug                   String   @unique
  ownerId                String   @map("owner_id")
  // Transfer Ownership dua langkah (ADR-050, DM-D11) — diisi saat Owner
  // memicu `transferOwnership`, dikosongkan lagi setelah target menerima
  // (`acceptOwnershipTransfer`) atau dibatalkan (`cancelOwnershipTransfer`).
  pendingOwnerTransferTo String?  @map("pending_owner_transfer_to")
  plan                   String   @default("free")
  brandName              String?  @map("brand_name")
  brandTone              String?  @map("brand_tone")
  brandGuidelines        String?  @map("brand_guidelines")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  members            WorkspaceMember[]
  invitations        WorkspaceInvitation[]
  connectedAccounts  WorkspaceConnectedAccount[]
  posts              PublishingPost[]
  aiRequests         AiRequest[]
  inboxItems         EngagementInboxItem[]
  analyticsSnapshots AnalyticsWorkspaceSnapshot[]
  startPages         StartPagePage[]
  mediaItems         MediaItem[]
  notifications      Notification[]
  channelOrders      WorkspaceChannelOrder[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id")
  role        String
  status      String    @default("pending")
  invitedAt   DateTime  @default(now()) @map("invited_at") @db.Timestamptz(6)
  joinedAt    DateTime? @map("joined_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  // Backs `current_user_workspace_ids()` (RLS helper, migration
  // 20260813073556) — every RLS-protected table's policy calls it, and it
  // filters on exactly (user_id, status).
  @@index([userId, status])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  email           String
  role            String
  token           String    @unique
  status          String    @default("pending") // pending | accepted | revoked | expired
  invitedByUserId String    @map("invited_by_user_id")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  /**
   * T-110 (KI-053) — verifikasi kepemilikan email accept-invite, HANYA
   * jalur `isExistingUser: false`. Kode OTP 6 digit di-hash (sha256, lihat
   * `workspace.service.ts`), TIDAK PERNAH disimpan plaintext.
   * `verificationCodeHash`/`verificationCodeExpiresAt` di-clear (null)
   * begitu kode benar dikonfirmasi (single-use) — lihat
   * `markInvitationEmailVerified`.
   */
  verificationCodeHash      String?   @map("verification_code_hash")
  verificationCodeExpiresAt DateTime? @map("verification_code_expires_at") @db.Timestamptz(6)
  /** Reset ke 0 tiap kode baru diminta (`setInvitationVerificationCode`); increment tiap kode salah (anti brute-force, maks 5 percobaan). */
  verificationAttempts      Int       @default(0) @map("verification_attempts")
  /** Diisi sekali (single-use) saat kode OTP dikonfirmasi benar — dipakai `WorkspaceService.acceptInvite` sebagai guard server-side (bukan klaim dari client). */
  emailVerifiedAt           DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("workspace_invitations")
}

model WorkspaceConnectedAccount {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  platform          String
  outstandAccountId String   @map("outstand_account_id")
  handle            String
  status            String   @default("active")
  /**
   * Foto profil akun terhubung (menutup KI-076, ADR-120) — nullable karena
   * Outstand tidak selalu punya/mengembalikan foto (mis. Instagram
   * single-page tanpa profile picture di sisi platform aslinya). Diisi
   * `WorkspaceService` dari `ConnectedAccountData.avatarUrl` (single-page,
   * `resolveConnectCallback`) atau hasil join `listPendingFacebookPages`
   * (Facebook Pages, `confirmFacebookPagesConnection`) — lihat
   * `packages/shared/src/contracts/outstand-adapter.ts`.
   */
  avatarUrl         String?  @map("avatar_url")
  reconnectRequired Boolean  @default(false) @map("reconnect_required")
  connectedAt       DateTime @default(now()) @map("connected_at") @db.Timestamptz(6)
  // Import Posts dari Social Account (T-090, ADR-093 poin 6) — watermark +
  // cooldown untuk JOB-05 (Import Posts Trigger). `lastImportedUntil`
  // di-update saat JOB-06 (processing) sukses menyelesaikan sebuah import;
  // dipakai sebagai `since` untuk trigger periodik & manual berikutnya
  // (bukan mengulang 90 hari tiap kali). `lastImportRequestedAt` di-update
  // SETIAP KALI import direquest (dari jalur manapun: auto/periodik/manual);
  // dipakai untuk cooldown 24 jam per akun jalur manual (ADR-093 poin 9).
  lastImportedUntil     DateTime? @map("last_imported_until") @db.Timestamptz(6)
  lastImportRequestedAt DateTime? @map("last_import_requested_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postTargets   PublishingPostTarget[]
  inboxItems    EngagementInboxItem[]
  channelOrders WorkspaceChannelOrder[]

  @@unique([workspaceId, outstandAccountId])
  @@index([workspaceId])
  @@map("workspace_connected_accounts")
}

/**
 * Urutan channel sidebar per user (T-012.1, ADR-058) — reorder drag-drop
 * bersifat personal, bukan workspace-wide, jadi disimpan per
 * (workspaceId, userId, connectedAccountId). `userId` tanpa relasi FK ke
 * `User`, konsisten dengan `WorkspaceMember.userId` (beda bounded context).
 * Strategi persist: full rewrite (delete+createMany) tiap drop — lihat
 * `WorkspaceService.saveChannelOrder`.
 */
model WorkspaceChannelOrder {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  userId             String   @map("user_id")
  connectedAccountId String   @map("connected_account_id") @db.Uuid
  position           Int
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace        Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedAccount WorkspaceConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, connectedAccountId])
  @@index([workspaceId, userId])
  @@map("workspace_channel_orders")
}

// ─────────────────────────────────────────────
// BC-03 — Publishing
// ─────────────────────────────────────────────

model PublishingPost {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  // Import Posts dari Social Account (T-090, ADR-093 poin 3) — nullable
  // sejak ADR-093 (sebelumnya wajib). INVARIANT: `null` HANYA kalau
  // `status = 'imported'` (post ditarik langsung dari platform sosial,
  // tidak punya "penulis" internal) — semua status lain tetap wajib punya
  // `authorId`. Tidak ada DB CHECK constraint untuk invariant ini (tidak
  // ada presedan CHECK lintas kolom seperti ini di schema — satu-satunya
  // CHECK existing, `engagement_inbox_items_type_check`, murni single-value
  // enum check, bukan conditional cross-column) — ditegakkan di level
  // Application Service (`ImportPostsProcessUseCase` mengisi `null`,
  // use-case lain yang membuat/mengubah post SELALU mewajibkan `authorId`)
  // sebagai defense-in-depth sesuai ADR-059 poin 6, bukan DB constraint.
  authorId String? @map("author_id")
  status   String  @default("draft")
  caption        String    @default("")
  mediaIds       String[]  @default([]) @map("media_ids") @db.Uuid
  scheduledAt    DateTime? @map("scheduled_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  failedAt       DateTime? @map("failed_at") @db.Timestamptz(6)
  failureReason  String?   @map("failure_reason")
  // Redesain ACL Outstand (2026-08-26, ADR baru): SATU id post-level dari
  // Outstand `create-a-post`, mencakup SEMUA target/akun dalam post ini —
  // menggantikan model lama di mana tiap `PublishingPostTarget` punya
  // job id sendiri (`outstandJobId`, sudah dihapus). Diisi lewat
  // `IPublishingRepository.setOutstandPostId` setelah
  // `OutstandAdapter.schedulePost`/`publishNow` resolve.
  // Unique constraint (bukan `@@unique` biasa — kolom ini nullable & harus
  // mengecualikan baris soft-deleted) dijaga lewat PARTIAL unique index raw
  // SQL, bukan Prisma DSL (partial/`WHERE` index tidak representable di
  // schema Prisma) — lihat migration
  // `20260907130000_t026_unique_outstand_post_id`. Ditambahkan setelah
  // review Ridwan Architecture Reviewer menemukan
  // `webhook_find_post_targets_by_outstand_post_id` (migration
  // `20260907120000_t026_outstand_webhook_system_lookups`) mengandalkan
  // keunikan kolom ini tanpa constraint DB — lapis pertama defense-in-depth,
  // lapis kedua: guard runtime di
  // `PublishingRepository.findPostTargetsByOutstandPostId`.
  outstandPostId String?   @map("outstand_post_id")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targets   PublishingPostTarget[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  // `listHistory`'s `publishedAtRange` filter (T-045/T-046/T-047, /analyze)
  // butuh `publishedAt` ikut ter-index bareng `workspaceId`+`status` supaya
  // Postgres tidak scan seluruh riwayat per-status sebelum menyaring rentang
  // tanggal — review finding 2026-09-22.
  @@index([workspaceId, status, publishedAt])
  @@index([scheduledAt])
  @@index([deletedAt])
  @@map("publishing_posts")
}

model PublishingPostTarget {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId              String   @map("post_id") @db.Uuid
  connectedAccountId  String   @map("connected_account_id") @db.Uuid
  platform            String
  contentFormat       String   @default("post") @map("content_format")
  platformOptions     Json?    @map("platform_options")
  // Redesain ACL Outstand (2026-08-26, ADR baru): `outstandJobId` (dulu
  // per-target job id, model yang salah — Outstand tidak punya job per
  // akun) diganti `platformPostId` — ID post di platform ASLI (Instagram,
  // dst.), BEDA dari `outstandPostId` post-level di `PublishingPost`.
  // Diisi belakangan via `OutstandAdapter.fetchPostOutcome` (polling) atau
  // webhook (T-026), bukan sinkron dari `schedulePost`/`publishNow`.
  platformPostId      String?  @map("platform_post_id")
  status              String   @default("pending")
  // Redesain 2026-08-26: `publishedUrl` → `platformPostUrl`, sumber data
  // sama seperti `platformPostId` di atas (async, per akun).
  platformPostUrl     String?  @map("platform_post_url")
  error               String?
  // Retry manual (T-034.4, ADR-092) — id post-level BARU dari
  // `OutstandAdapter.publishNow` khusus untuk recreate TARGET INI SAJA
  // (keputusan scope: retry single-target, bukan seluruh post). BEDA dari
  // `PublishingPost.outstandPostId`, yang tetap merepresentasikan create
  // original untuk SEMUA target awal dan tidak disentuh oleh retry —
  // konsekuensinya target yang berhasil di-retry punya id post-level
  // sendiri yang berbeda dari saudara-saudaranya di post yang sama. Dipakai
  // sebagai argumen `fetchPostOutcome` untuk resolve outcome retry ini
  // (bukan `PublishingPost.outstandPostId`, yang outcome-nya sudah tidak
  // relevan untuk target yang sedang di-retry). Nullable — kosong sampai
  // retry pertama kali dijalankan untuk target ini.
  retryOutstandPostId String?  @map("retry_outstand_post_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  post             PublishingPost            @relation(fields: [postId], references: [id], onDelete: Cascade)
  connectedAccount WorkspaceConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([connectedAccountId])
  @@map("publishing_post_targets")
}

// PublishingQueueSlot dropped (ADR-083, T-032.5) — Queue is a computed view
// over PublishingPost/PublishingPostTarget (status Scheduled), not a
// persisted slot entity. See database-strategy.md for the historical
// mapping note.

// ─────────────────────────────────────────────
// BC-04 — AI Assistant
// ─────────────────────────────────────────────

model AiRequest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id")
  postId      String?  @map("post_id") @db.Uuid
  type        String
  prompt      String
  context     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  results   AiResult[]

  @@index([workspaceId])
  @@map("ai_requests")
}

model AiResult {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  content      String
  variantIndex Int      @default(0) @map("variant_index")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request AiRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("ai_results")
}

// ─────────────────────────────────────────────
// BC-05 — Engagement
// ─────────────────────────────────────────────

model EngagementInboxItem {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  connectedAccountId String    @map("connected_account_id") @db.Uuid
  platform           String
  type               String    @default("comment")
  externalId         String    @map("external_id")
  authorHandle       String    @map("author_handle")
  content            String
  status             String    @default("unread")
  postId             String?   @map("post_id") @db.Uuid
  receivedAt         DateTime  @map("received_at") @db.Timestamptz(6)
  readAt             DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace        Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedAccount WorkspaceConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  replies          EngagementReply[]

  @@unique([workspaceId, connectedAccountId, externalId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([externalId])
  @@map("engagement_inbox_items")
}

model EngagementReply {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inboxItemId     String   @map("inbox_item_id") @db.Uuid
  userId          String   @map("user_id")
  content         String
  outstandReplyId String?  @map("outstand_reply_id")
  status          String   @default("pending")
  sentAt          DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  inboxItem EngagementInboxItem @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)

  @@map("engagement_replies")
}

// ─────────────────────────────────────────────
// BC-06 — Analytics
// ─────────────────────────────────────────────

model AnalyticsPostMetric {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId             String   @map("post_id") @db.Uuid
  connectedAccountId String   @map("connected_account_id") @db.Uuid
  platform           String
  impressions        Int      @default(0)
  reach              Int      @default(0)
  likes              Int      @default(0)
  comments           Int      @default(0)
  shares             Int      @default(0)
  clicks             Int?
  engagementRate     Decimal  @default(0) @map("engagement_rate") @db.Decimal(5, 4)
  fetchedAt          DateTime @map("fetched_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Satu baris per (post, akun tujuan) — sejalan dengan komentar
  // `IAnalyticsRepository.findMetricsByPost` ("satu baris per
  // target/platform untuk satu post"). Constraint ini WAJIB untuk upsert
  // idempoten T-041.5 (ingestion ulang menimpa baris yang sama, bukan
  // menggandakan).
  @@unique([postId, connectedAccountId])
  @@index([postId])
  @@map("analytics_post_metrics")
}

model AnalyticsWorkspaceSnapshot {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  period            String
  periodStart       DateTime @map("period_start") @db.Date
  periodEnd         DateTime @map("period_end") @db.Date
  totalPosts        Int      @default(0) @map("total_posts")
  totalReach        BigInt   @default(0) @map("total_reach")
  totalEngagements  BigInt   @default(0) @map("total_engagements")
  avgEngagementRate Decimal  @default(0) @map("avg_engagement_rate") @db.Decimal(5, 4)
  topPostId         String?  @map("top_post_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, period, periodStart])
  @@index([workspaceId])
  @@map("analytics_workspace_snapshots")
}

// ─────────────────────────────────────────────
// BC-07 — Start Page
// ─────────────────────────────────────────────

model StartPagePage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  slug        String   @unique
  title       String
  bio         String?
  avatarUrl   String?  @map("avatar_url")
  theme       String   @default("default")
  isPublished Boolean  @default(false) @map("is_published")
  viewCount   BigInt   @default(0) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  links     StartPageLink[]

  @@index([workspaceId])
  @@map("start_page_pages")
}

model StartPageLink {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startPageId String   @map("start_page_id") @db.Uuid
  label       String
  url         String
  position    Int
  isActive    Boolean  @default(true) @map("is_active")
  clickCount  BigInt   @default(0) @map("click_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  startPage StartPagePage @relation(fields: [startPageId], references: [id], onDelete: Cascade)

  @@map("start_page_links")
}

// ─────────────────────────────────────────────
// BC-08 — Media
// ─────────────────────────────────────────────

model MediaItem {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  uploaderId         String    @map("uploader_id")
  filename           String
  mimeType           String    @map("mime_type")
  size               BigInt
  url                String?
  storagePath        String    @map("storage_path")
  outstandMediaId    String?   @map("outstand_media_id")
  outstandMediaUrl   String?   @map("outstand_media_url")
  outstandUploadedAt DateTime? @map("outstand_uploaded_at") @db.Timestamptz(6)
  outstandExpiresAt  DateTime? @map("outstand_expires_at") @db.Timestamptz(6)
  type               String
  width              Int?
  height             Int?
  duration           Decimal?  @db.Decimal(10, 2)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("media_items")
}

// ─────────────────────────────────────────────
// BC-09 — Notification
// ─────────────────────────────────────────────

model Notification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  userId            String    @map("user_id")
  type              String
  title             String
  body              String
  isRead            Boolean   @default(false) @map("is_read")
  relatedEntityType String?   @map("related_entity_type")
  relatedEntityId   String?   @map("related_entity_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt            DateTime? @map("read_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// System — Background Jobs (cross-cutting)
// ─────────────────────────────────────────────

model BackgroundJob {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String
  payload     Json
  status      String    @default("pending")
  scheduledAt DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  // BG-D04 (`background-jobs.md`) mendokumentasikan 3 tier backoff (5/15/60
  // menit) sebelum dead-letter — butuh 4 percobaan total (percobaan 1-3
  // masing-masing retry, percobaan ke-4 dead-letter), bukan 3. Default 3
  // sebelumnya membuat tier 60 menit tidak pernah tercapai (lihat
  // `retryDelayMs` di `src/lib/jobs/backoff.ts`).
  maxAttempts Int       @default(4) @map("max_attempts")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, scheduledAt])
  @@map("background_jobs")
}

model OutstandWebhookEvent {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outstandEventId    String    @unique @map("outstand_event_id")
  eventType          String    @map("event_type")
  rawBody            String    @map("raw_body")
  status             String    @default("received")
  processingAttempts Int       @default(0) @map("processing_attempts")
  lastError          String?   @map("last_error")
  receivedAt         DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt        DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, receivedAt])
  @@map("outstand_webhook_events")
}
