{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "/apps/**",
      "/packages/**",
      "/patches/**",
      "/scripts/trigger-*.ts",
      "/package.json",
      "/bun.lock",
      "/tsconfig.json",
      "/railway*.json"
    ]
  },
  "deploy": {
    "startCommand": "bun run scripts/trigger-analytics-sync.ts",
    "cronSchedule": "0 0 * * *",
    "restartPolicyType": "NEVER"
  }
}
