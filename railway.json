{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "/apps/**",
      "/packages/**",
      "/patches/**",
      "/scripts/trigger-*.ts",
      "/package.json",
      "/bun.lock",
      "/tsconfig.json",
      "/railway*.json"
    ]
  },
  "deploy": {
    "startCommand": "bun run --cwd apps/web start",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
